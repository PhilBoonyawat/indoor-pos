{
    "Weighted KNN": {
        "model": "KNeighborsClassifier",
        "params": {
            "n_neighbors": 3,
            "weights": "distance",
            "metric": "manhattan",
            "n_jobs": -1
        }
    },
    "Random Forest": {
        "model": "RandomForestClassifier",
        "params": {
            "n_estimators": 50,
            "max_features": "log2",
            "max_depth": null,
            "min_samples_split": 5,
            "min_samples_leaf": 1,
            "random_state": 42,
            "n_jobs": -1
        }
    },
    "SVM": {
        "model": "SVC",
        "params": {
            "kernel": "rbf",
            "C": 10,
            "gamma": "scale",
            "random_state": 42,
            "probability": true
        }
    },
    "MLP": {
        "model": "MLPClassifier",
        "params": {
            "hidden_layer_sizes": [
                256,
                128
            ],
            "alpha": 1e-05,
            "activation": "relu",
            "solver": "adam",
            "learning_rate": "adaptive",
            "learning_rate_init": 0.0005,
            "max_iter": 500,
            "early_stopping": true,
            "validation_fraction": 0.15,
            "n_iter_no_change": 20,
            "random_state": 42
        }
    }
}